# MenuMate Backend 환경 변수 (docs/env-guide.md 3장)
# 처음 설치할 때 이 파일을 .env로 복사한다. .env는 커밋하지 않는다.
# 경로는 backend/ 폴더 기준 상대 경로, 구분자는 / 로 쓴다.

# API 서버 포트
PORT=4000
# 같은 노트북에서만 접속
HOST=127.0.0.1
# DB 접속정보. DATABASE_URL의 상대 경로는 backend/ 폴더 기준 (prisma/ 폴더 기준이 아님). PostgreSQL로 바꾸면 postgresql://user:pass@localhost:5432/menumate
DATABASE_URL=file:./data/menumate.db
# 시드에 쓸 메뉴 JSON. 우루루 실데이터가 오면 이 값만 바꾼다
MENU_SEED_FILE=./seed/menu.dummy.json
# 메뉴 사진 폴더 → /static/menu-images/*
MENU_IMAGE_DIR=./data/menu-images
# AI 모델 폴더 → /models/*
MODEL_DIR=../ai/models
# 전시용 단일 실행 시 제공할 프론트 빌드 폴더. 없으면 건너뜀
FRONTEND_DIST=../frontend/dist
# 지금은 simulate만 지원
PAYMENT_MODE=simulate
# 요청에 simulate가 없을 때의 결과 (success / fail)
PAYMENT_SIM_RESULT=success
# 결제 중 화면을 보여 줄 지연 시간 (밀리초)
PAYMENT_SIM_DELAY_MS=1500
# 리뷰 학습 엔진 결과 파일 (v2, AI가 만듦). 없거나 형식이 틀리면 v1 점수로 추천
ENGINE_FILE=./engine/menu-features.json
# 주문번호 날짜 기준 시간대
TZ=Asia/Seoul
