# MenuMate Backend 환경 변수 (docs/env-guide.md 3장)
# 처음 설치할 때 이 파일을 .env로 복사한다. .env는 커밋하지 않는다.
# 경로는 backend/ 폴더 기준 상대 경로, 구분자는 / 로 쓴다.

# API 서버 포트 (Render는 PORT를 자동으로 넣어 준다)
PORT=4000
# 로컬은 127.0.0.1, Render 같은 클라우드는 0.0.0.0
HOST=127.0.0.1
# DB 접속정보. DATABASE_URL의 상대 경로는 backend/ 폴더 기준 (prisma/ 폴더 기준이 아님). PostgreSQL로 바꾸면 postgresql://user:pass@localhost:5432/menumate
DATABASE_URL=file:./data/menumate.db
# 시드에 쓸 메뉴 JSON. 우루루 실데이터가 오면 이 값만 바꾼다
MENU_SEED_FILE=./seed/menu.dummy.json
# 메뉴 사진 폴더 → /static/menu-images/*. 기본은 더미 예시 사진(출처: seed/menu-images/CREDITS.md). 실데이터 사진이 오면 이 값만 바꾼다
MENU_IMAGE_DIR=./seed/menu-images
# AI 모델 폴더 → /models/*
MODEL_DIR=../ai/models
# 전시용 단일 실행 시 제공할 프론트 빌드 폴더. 없으면 건너뜀
FRONTEND_DIST=../frontend/dist
# 지금은 simulate만 지원
PAYMENT_MODE=simulate
# 요청에 simulate가 없을 때의 결과 (success / fail)
PAYMENT_SIM_RESULT=success
# 결제 중 화면을 보여 줄 지연 시간 (밀리초)
PAYMENT_SIM_DELAY_MS=1500
# 리뷰 학습 엔진 결과 파일 (v2, AI가 만듦). 없거나 형식이 틀리면 v1 점수로 추천
ENGINE_FILE=./engine/menu-features.json
# 주문번호 날짜 기준 시간대
TZ=Asia/Seoul

# ---- v3 (2026-11-02): 온라인 기능. 키는 이 파일(.env)에만 두고 프론트 VITE_ 변수에는 절대 넣지 않는다 ----
# 허용할 브라우저 출처(쉼표 구분). 비우면 모두 허용(개발용). 배포 예: https://menumate-dl.vercel.app
CORS_ORIGIN=
# 대화형 추천 AI: gemini(기본) 또는 claude. 고른 쪽 키가 비면 /api/chat은 503이고 프론트는 규칙 해석으로 진행
LLM_PROVIDER=gemini
# Claude Console에서 발급(서비스 계정 키 권장). LLM_PROVIDER=claude일 때만 쓴다
ANTHROPIC_API_KEY=
# 기본 claude-sonnet-5-5. 더 똑똑하게: claude-opus-5-5, 더 빠르고 싸게: claude-haiku-5-5
CLAUDE_MODEL=claude-sonnet-5-5
# 생각하는 깊이: low / medium / high / xhigh / max. 높을수록 느리고 비싸다
CLAUDE_EFFORT=medium
# Google AI Studio에서 발급. LLM_PROVIDER=gemini일 때 쓴다
GEMINI_API_KEY=
# 기본은 가장 빠른 모델(키오스크 대기 시간). 답변 품질을 올리려면 gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
# 음성 안내. Google Cloud 콘솔에서 Text-to-Speech API 활성화 후 API 키 발급. 비우면 /api/tts는 503이고 프론트는 브라우저 TTS로 진행
GOOGLE_TTS_API_KEY=
# 밝은 직원 목소리. ko-KR Chirp3-HD: Leda, Aoede, Kore(여성) / Puck, Charon(남성). 구형: ko-KR-Neural2-A
TTS_VOICE=ko-KR-Chirp3-HD-Leda
# 날씨(Open-Meteo, 키 불필요)에 쓸 매장 좌표. 기본은 우루루 평촌본점 근처
WEATHER_LAT=37.3943
WEATHER_LON=126.9568
# 혼잡도: 최근 N분 결제 완료 주문 수 (0~1 한산, 2~4 보통, 5+ 붐빔)
CONTEXT_CROWD_WINDOW_MIN=15
# 대화·추천이 읽는 우루루 메뉴 데이터 폴더 (menus.json, review/menu_reviews.json)
MENU_DATA_DIR=../frontend/src/prototype/menu
