# Frontend 환경 변수 (docs/env-guide.md 4장). VITE_ 변수는 빌드 결과물에 그대로 들어가므로 비밀 값 금지.
VITE_API_BASE_URL=
VITE_FACE_MODEL_URL=/models/face/blaze_face_short_range.tflite
VITE_AGE_MODEL_URL=/models/age/age_estimator.onnx
VITE_MEDIAPIPE_WASM_URL=/models/mediapipe-wasm
VITE_ORT_WASM_URL=/models/ort-wasm/
VITE_AI_STABLE_FRAMES=5
VITE_AI_MIN_CONFIDENCE=0.6
VITE_AI_DECIDE_TIMEOUT_MS=8000
VITE_AI_NO_FACE_GRACE_MS=1500
VITE_IDLE_RESET_MS=60000
VITE_DONE_RESET_MS=15000
VITE_TTS_RATE=0.85
VITE_DEV_SHORTCUTS=true

# 통합 전 개발용 가짜 모듈 (frontend/src/mocks). AI·Backend 브랜치와 합친 뒤 false 로 바꾼다.
# production 빌드(npm run build)에서 둘 중 하나라도 true 이면 빌드가 실패한다 (전시 빌드에 가짜가 들어가지 않게)
VITE_MOCK_AI=true
VITE_MOCK_API=true
