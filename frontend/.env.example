# Frontend 환경 변수 (docs/env-guide.md 4장). VITE_ 변수는 빌드 결과물에 그대로 들어가므로 비밀 값 금지.

# 서버 주소. 개발 중에는 비워 두면 Vite 프록시가 /api·/models·/static을 localhost:4000으로 보낸다.
# Vercel 배포 예: VITE_API_BASE_URL=https://menumate-api.onrender.com  (모델 URL들은 비워 두면 이 주소 아래 /models/... 를 쓴다)
VITE_API_BASE_URL=
VITE_FACE_MODEL_URL=
VITE_LANDMARKER_MODEL_URL=
VITE_AGE_MODEL_URL=
VITE_MEDIAPIPE_WASM_URL=
VITE_ORT_WASM_URL=
VITE_STT_MODEL_URL=
VITE_AI_STABLE_FRAMES=5
VITE_AI_MIN_CONFIDENCE=0.6
VITE_AI_DECIDE_TIMEOUT_MS=8000
VITE_AI_NO_FACE_GRACE_MS=1500
VITE_IDLE_RESET_MS=60000
VITE_DONE_RESET_MS=15000
VITE_TTS_RATE=0.85
# 서버 음성 합성(Google TTS)·대화형 추천(Gemini)·카메라 불편 신호. false면 각각 브라우저 TTS·규칙 해석·끔
VITE_TTS_SERVER=true
VITE_CHAT_SERVER=true
VITE_FACE_SIGNALS=true
VITE_DEV_SHORTCUTS=true
# 간편주문(말로 추천) 화면 안. board 주문 확인 보드(기본, 2026-11-03) / 비교용 a 직원과 마주 앉기 / b 눌러서 답하기 / c 한눈에 정리. 주소 뒤 ?rec=b 처럼 붙이면 이 값보다 우선
VITE_RECOMMEND_LAYOUT=board

# 개발용 가짜 모듈 (frontend/src/mocks). 실제 모델·서버와 함께 쓸 때는 false.
# production 빌드(npm run build)에서 둘 중 하나라도 true 이면 빌드가 실패한다 (전시·배포 빌드에 가짜가 들어가지 않게)
VITE_MOCK_AI=false
VITE_MOCK_API=false
