# Aiven(클라우드 MySQL)에 테이블·메뉴·리뷰 근거·점주 계정을 넣을 때 쓰는 접속 정보.
# 이 파일을 .env.aiven 으로 복사해서 Aiven 콘솔의 Connection information 값으로 채운다 (.env.aiven은 커밋되지 않음).
# 사용:  npm run cloud:setup            (테이블 + 메뉴 80개 + 리뷰 근거)
#        npm run cloud:seed-admin -- --password <점주 비밀번호>
DB_HOST=menumate-mysql-xxxx.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# Aiven 콘솔에서 받은 CA 인증서를 certs/aiven-ca.pem 으로 저장 (certs/ 폴더도 커밋되지 않음)
DB_SSL_CA_FILE=certs/aiven-ca.pem
