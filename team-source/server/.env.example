# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요. .env는 git에 커밋하지 마세요.
#
# 보안 원칙:
# - DB 계정, LLM API 키, 관리자 키는 이 서버의 .env에만 둔다 (프론트엔드 VITE_ 환경변수에는 절대 두지 않음).
# - LLM 호출은 반드시 이 백엔드에서만 수행한다.

# --- 서버 ---
PORT=4000
# 콤마로 여러 origin 허용 가능 (예: http://localhost:5173,http://localhost:4173)
CORS_ORIGIN=http://localhost:5173

# --- MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kiosk_app
DB_PASSWORD=1234
DB_NAME=kiosk_dev
DB_CONNECTION_LIMIT=10

# --- LLM 기반 조건 추출 (선택) ---
# 비워두면 서버는 자동으로 규칙 기반 조건 추출기만 사용한다 (키 없이도 전체 기능 동작).
# OpenAI 호환 Chat Completions 엔드포인트의 베이스 URL (예: https://api.openai.com/v1)
LLM_API_BASE=
# API 키 (절대 코드/프론트엔드에 하드코딩하지 말 것)
LLM_API_KEY=
# 사용할 모델 이름
LLM_MODEL=

# --- 점주 관리자 로그인 ---
# 관리자 로그인 토큰(JWT) 서명 비밀값. 반드시 고유한 임의 문자열로 바꿀 것 — 기본값을 그대로 쓰면
# 누구나 토큰을 위조해 관리자 API를 호출할 수 있다. (예: openssl rand -hex 32)
ADMIN_JWT_SECRET=dev-only-change-me-before-exhibition
