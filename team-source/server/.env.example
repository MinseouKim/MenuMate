# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요. .env는 git에 커밋하지 마세요.
#
# 보안 원칙:
# - DB 계정, LLM API 키, 관리자 키는 이 서버의 .env에만 둔다 (프론트엔드 VITE_ 환경변수에는 절대 두지 않음).
# - LLM 호출은 반드시 이 백엔드에서만 수행한다.

# --- 서버 ---
# development(기본) | test | production. production일 때만 ADMIN_JWT_SECRET이 필수가 되고
# CORS_ORIGIN이 localhost로 남아 있으면 경고를 띄운다.
NODE_ENV=development
PORT=4000
# 콤마로 여러 origin 허용 가능 (예: http://localhost:5173,http://localhost:4173)
# 운영 배포 시에는 실제 키오스크/관리자 화면 도메인만 넣을 것 — localhost를 그대로 두면 안 된다.
CORS_ORIGIN=http://localhost:5173

# --- MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kiosk_app
DB_PASSWORD=1234
DB_NAME=kiosk_dev
DB_CONNECTION_LIMIT=10

# --- LLM 기반 조건 추출 (선택) ---
# 비워두면 서버는 자동으로 규칙 기반 조건 추출기만 사용한다 (키 없이도 전체 기능 동작).
# OpenAI 호환 Chat Completions 엔드포인트의 베이스 URL (예: https://api.openai.com/v1)
LLM_API_BASE=
# API 키 (절대 코드/프론트엔드에 하드코딩하지 말 것)
LLM_API_KEY=
# 사용할 모델 이름
LLM_MODEL=

# --- 점주 관리자 로그인 ---
# 관리자 로그인 토큰(JWT) 서명 비밀값. 개발 중에는 비워 둬도 알려진 개발용 기본값으로 동작하지만,
# NODE_ENV=production에서는 반드시 채워야 한다 — 비어 있으면 서버가 시작하지 않는다.
# (예: openssl rand -hex 32)
ADMIN_JWT_SECRET=
