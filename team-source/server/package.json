{
  "name": "kiosk-server",
  "version": "0.1.0",
  "private": true,
  "description": "음성인식 메뉴 추천 키오스크 — 백엔드 API (Express + MySQL 8, ORM 미사용)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/runMigrations.ts",
    "migrate:bootstrap": "tsx src/db/bootstrapMigrationTracking.ts",
    "import:real-menu": "tsx src/db/importRealMenu.ts",
    "seed:build": "tsx scripts/buildUruruSeed.ts",
    "seed:admin": "tsx src/db/seedAdmin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
