{
  "name": "menumate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix team-source run dev -- --host 127.0.0.1 --port 5173",
    "build": "npm --prefix team-source run build",
    "test": "cd team-source && node node_modules/vitest/vitest.mjs run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "preview": "npm --prefix team-source run preview -- --host 127.0.0.1 --port 4173 --strictPort",
    "setup:client": "npm --prefix team-source ci",
    "deploy:vercel": "npx -y vercel@64.2.0 deploy --prod --yes && npx -y vercel@64.2.0 alias rm menumate-dohee12s-projects.vercel.app --yes"
  }
}